{
  "name": "commit-date-selector",
  "displayName": "Commit Date Selector",
  "description": "Select a custom timestamp for your git commits",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "publisher": "PKief",
  "author": {
    "name": "Philipp Kief",
    "email": "philipp.kief@gmx.de",
    "url": "https://github.com/PKief"
  },
  "funding": "https://github.com/sponsors/PKief",
  "sponsor": {
    "url": "https://github.com/sponsors/PKief"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PKief/vscode-git-commit-date.git"
  },
  "bugs": {
    "url": "https://github.com/PKief/vscode-git-commit-date/issues"
  },
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "license": "MIT",
  "type": "module",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "commit",
    "date",
    "timestamp",
    "version control"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitDateSelector.setDate",
        "title": "Set Commit Date",
        "category": "Git",
        "icon": {
          "dark": "images/calendar-edit.svg",
          "light": "images/calendar-edit_light.svg"
        }
      },
      {
        "command": "commitDateSelector.commitWithDate",
        "title": "Commit with Custom Date",
        "category": "Git",
        "icon": {
          "dark": "images/calendar-check.svg",
          "light": "images/calendar-check_light.svg"
        }
      },
      {
        "command": "commitDateSelector.clearDate",
        "title": "Clear Custom Commit Date",
        "category": "Git",
        "icon": {
          "dark": "images/calendar-remove.svg",
          "light": "images/calendar-remove_light.svg"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "commitDateSelector.setDate"
        },
        {
          "command": "commitDateSelector.commitWithDate"
        },
        {
          "command": "commitDateSelector.clearDate"
        }
      ],
      "scm/title": [
        {
          "command": "commitDateSelector.setDate",
          "group": "navigation@-10",
          "when": "scmProvider == git"
        },
        {
          "command": "commitDateSelector.commitWithDate",
          "group": "navigation@-11",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "Commit Date Selector",
      "properties": {
        "commitDateSelector.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show selected commit date in status bar"
        },
        "commitDateSelector.dateFormat": {
          "type": "string",
          "default": "YYYY-MM-DD HH:mm:ss",
          "description": "Date format for display"
        },
        "commitDateSelector.customDate": {
          "type": "string",
          "default": "",
          "description": "The custom commit date to use (ISO 8601 string, managed by the extension)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./",
    "build": "bun run compile && bun ./build/build-with-esbuild.ts",
    "watch": "bun ./build/watch-with-esbuild.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "prepare": "husky",
    "update-dependencies": "bun update"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.5",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.4",
    "@types/vscode": "1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vscode/test-electron": "^2.5.2",
    "bun-types": "^1.2.17",
    "changelogen": "^0.6.1",
    "commitlint": "^19.8.1",
    "esbuild": "^0.25.5",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  }
}
