{
  "name": "commit-date-selector",
  "displayName": "Commit Date Selector",
  "description": "Select a custom timestamp for your git commits",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "license": "MIT",
  "type": "module",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "commit",
    "date",
    "timestamp",
    "version control"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitDateSelector.setDate",
        "title": "Set Commit Date",
        "category": "Git"
      },
      {
        "command": "commitDateSelector.commitWithDate",
        "title": "Commit with Custom Date",
        "category": "Git"
      },
      {
        "command": "commitDateSelector.clearDate",
        "title": "Clear Custom Commit Date",
        "category": "Git"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "commitDateSelector.setDate"
        },
        {
          "command": "commitDateSelector.commitWithDate"
        },
        {
          "command": "commitDateSelector.clearDate"
        }
      ],
      "scm/title": [
        {
          "command": "commitDateSelector.setDate",
          "group": "navigation",
          "when": "scmProvider == git"
        },
        {
          "command": "commitDateSelector.commitWithDate",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "Commit Date Selector",
      "properties": {
        "commitDateSelector.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show selected commit date in status bar"
        },
        "commitDateSelector.dateFormat": {
          "type": "string",
          "default": "YYYY-MM-DD HH:mm:ss",
          "description": "Date format for display"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile:declarations": "tsc -p ./tsconfig.declarations.json",
    "compile": "tsc",
    "build": "bun run compile && bun ./build/build-with-esbuild.ts",
    "watch": "bun ./build/watch-with-esbuild.ts",
    "postcompile": "bun run compile:declarations",
    "lint": "biome check",
    "format": "biome format --write",
    "prepare": "husky",
    "update-dependencies": "bun update"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.5",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.4",
    "@types/vscode": "1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vscode/test-electron": "^2.5.2",
    "bun-types": "^1.2.17",
    "changelogen": "^0.6.1",
    "commitlint": "^19.8.1",
    "esbuild": "^0.25.5",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  }
}
