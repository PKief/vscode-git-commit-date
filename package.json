{
  "name": "commit-date-selector",
  "displayName": "Commit Date Selector",
  "description": "Select a custom timestamp for your git commits",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "commit",
    "date",
    "timestamp",
    "version control"
  ],
  "activationEvents": [
    "onCommand:commitDateSelector.setDate",
    "onCommand:commitDateSelector.commitWithDate",
    "onCommand:commitDateSelector.clearDate"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitDateSelector.setDate",
        "title": "Set Commit Date",
        "category": "Git"
      },
      {
        "command": "commitDateSelector.commitWithDate",
        "title": "Commit with Custom Date",
        "category": "Git"
      },
      {
        "command": "commitDateSelector.clearDate",
        "title": "Clear Custom Commit Date",
        "category": "Git"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "commitDateSelector.setDate"
        },
        {
          "command": "commitDateSelector.commitWithDate"
        },
        {
          "command": "commitDateSelector.clearDate"
        }
      ],
      "scm/title": [
        {
          "command": "commitDateSelector.setDate",
          "group": "navigation",
          "when": "scmProvider == git"
        },
        {
          "command": "commitDateSelector.commitWithDate",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "Commit Date Selector",
      "properties": {
        "commitDateSelector.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show selected commit date in status bar"
        },
        "commitDateSelector.dateFormat": {
          "type": "string",
          "default": "YYYY-MM-DD HH:mm:ss",
          "description": "Date format for display"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc",
    "watch": "tsc -watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  }
}
